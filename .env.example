# Copy to .env only to override these values (.env is git-ignored).
# Local, obviously non-secret defaults shared by compose.yaml and the dev profile.
DB_PORT=5432
DB_NAME=tractor
DB_USER=tractor
DB_PASSWORD=tractor
# Optional full JDBC URL for the dev profile. Use 127.0.0.1, not localhost: compose publishes
# postgres on IPv4 loopback only and localhost may resolve to ::1 first.
# DB_URL=jdbc:postgresql://127.0.0.1:5432/tractor
